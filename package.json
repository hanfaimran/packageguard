{
  "name": "packageguard-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "eval"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --build --emitDeclarationOnly false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "npm --workspace=eval run demo"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
